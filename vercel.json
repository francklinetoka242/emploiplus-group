{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payments/pawapay/callback",
      "destination": "/api/payments/pawapay?pawapayRoute=deposit-callback"
    },
    {
      "source": "/api/payments/pawapay/initiate",
      "destination": "/api/payments/pawapay?pawapayRoute=initiate"
    },
    {
      "source": "/api/payments/pawapay/providers",
      "destination": "/api/payments/pawapay?pawapayRoute=providers"
    },
    {
      "source": "/api/payments/pawapay/reconcile",
      "destination": "/api/payments/pawapay?pawapayRoute=reconcile"
    },
    {
      "source": "/api/payments/pawapay/status",
      "destination": "/api/payments/pawapay?pawapayRoute=status"
    },
    {
      "source": "/api/payments/pawapay/subscription",
      "destination": "/api/payments/pawapay?pawapayRoute=subscription"
    },
    {
      "source": "/api/payments/pawapay/checkouts/callback",
      "destination": "/api/payments/pawapay?pawapayRoute=checkout-callback"
    },
    {
      "source": "/api/payments/pawapay/payouts/callback",
      "destination": "/api/payments/pawapay?pawapayRoute=payout-callback"
    },
    {
      "source": "/api/payments/pawapay/refunds/callback",
      "destination": "/api/payments/pawapay?pawapayRoute=refund-callback"
    },
    {
      "source": "/api/mobile",
      "destination": "/api/mobile"
    },
    {
      "source": "/api/maelise-conversation",
      "destination": "/api/maelise-permissions?action=conversation"
    },
    {
      "source": "/api/password-reset-request",
      "destination": "/api/password-reset?action=request"
    },
    {
      "source": "/api/password-reset-validate",
      "destination": "/api/password-reset?action=validate"
    },
    {
      "source": "/api/password-reset-confirm",
      "destination": "/api/password-reset?action=confirm"
    },
    {
      "source": "/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/payments/pawapay/reconcile",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/mobile-:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
