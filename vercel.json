
{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/mobile",
      "destination": "/api/mobile"
    },
    {
      "source": "/api/maelise-conversation",
      "destination": "/api/maelise-permissions?action=conversation"
    },
    {
      "source": "/api/password-reset-request",
      "destination": "/api/password-reset?action=request"
    },
    {
      "source": "/api/password-reset-validate",
      "destination": "/api/password-reset?action=validate"
    },
    {
      "source": "/api/password-reset-confirm",
      "destination": "/api/password-reset?action=confirm"
    },
    {
      "source": "/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/mobile-:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}